<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_tour_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tour_step_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tour_badge_bg"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="STEP 1 OF 4"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_tour_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Skip"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_tour_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Hero Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tour_icon_bg"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_tour_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Tour Step Icon"
                    android:src="@drawable/ic_tour_welcome" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_tour_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Welcome to APK Compiler"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Subtitle / Tag -->
            <TextView
                android:id="@+id/tv_tour_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="On-Device Compiler &amp; Git Cloner"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tv_tour_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Powerful on-device Git cloner &amp; Android compiler without PC or Termux."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- Feature highlights container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tour_features_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Feature 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginRight="8dp"
                        android:contentDescription="Feature Bullet"
                        android:src="@drawable/ic_tour_check" />

                    <TextView
                        android:id="@+id/tv_tour_feat_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compile standalone APKs directly on your device"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Feature 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginRight="8dp"
                        android:contentDescription="Feature Bullet"
                        android:src="@drawable/ic_tour_check" />

                    <TextView
                        android:id="@+id/tv_tour_feat_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Zero external dependencies - No Termux or PC needed"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Feature 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginRight="8dp"
                        android:contentDescription="Feature Bullet"
                        android:src="@drawable/ic_tour_check" />

                    <TextView
                        android:id="@+id/tv_tour_feat_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Complete offline pipeline: AAPT2, ECJ, D8 &amp; apksig"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Progress Dots -->
        <LinearLayout
            android:id="@+id/container_tour_dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_tour_0"
                android:layout_width="18dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/tour_dot_active" />

            <View
                android:id="@+id/dot_tour_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/tour_dot_inactive" />

            <View
                android:id="@+id/dot_tour_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/tour_dot_inactive" />

            <View
                android:id="@+id/dot_tour_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/tour_dot_inactive" />
        </LinearLayout>

        <!-- Previous Button -->
        <Button
            android:id="@+id/btn_tour_prev"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/btn_tour_secondary"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Previous"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Next / Get Started Button -->
        <Button
            android:id="@+id/btn_tour_next"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_tour_primary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/bg_main"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
