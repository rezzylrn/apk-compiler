<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="MainActivity.java"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_editor_file_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.4 KB"
            android:textColor="@color/primary_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_editor_file_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:text="/path/to/file"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

    <!-- Code Editor Box -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/console_bg"
        android:fillViewport="true">

        <EditText
            android:id="@+id/et_code_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|left"
            android:padding="10dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:typeface="monospace" />
    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="right"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_editor_close"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_secondary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_editor_save"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_primary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#0B132B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
